# Sao chép file này thành .env khi chạy local:
#   copy .env.example .env
# KHÔNG commit file .env lên GitHub.

# API key AI (ShopAIKey bắt đầu bằng sk- hoặc Gemini gốc)
GEMINI_API_KEY=sk-your-key-here

# ─────────────────────────────────────────────────────────────
# ĐỔI MODEL AI
#
# Key ShopAIKey (sk-...) dùng được NHIỀU dòng model trên cùng một
# endpoint — chỉ cần đổi tên model, KHÔNG phải đổi key.
# Đã kiểm chứng chạy được:
#     claude-sonnet-4-5            Claude, viết tự nhiên hơn Gemini
#     claude-haiku-4-5-20251001    Claude bản nhẹ, rẻ hơn
#     claude-opus-4-5              Claude mạnh nhất, đắt hơn
#     gemini-2.5-flash             mặc định, nhanh và rẻ
# Xem danh sách đầy đủ: https://shopaikey.com/models
# ─────────────────────────────────────────────────────────────
# SHOPAIKEY_MODEL=claude-sonnet-4-5

# Model khi dùng Gemini API key gốc (không phải sk-)
# GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────
# CLAUDE CHÍNH CHỦ (ANTHROPIC)
# Chỉ cần khi bạn có key trực tiếp từ console.anthropic.com
# (dạng sk-ant-api03-...). Hệ thống tự nhận diện, gọi thẳng
# api.anthropic.com, không cần cấu hình gì thêm.
# ─────────────────────────────────────────────────────────────
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Endpoint proxy Claude khác ShopAIKey (hiếm khi cần)
# CLAUDE_PROXY_URL=https://ten-dich-vu.com/v1/chat/completions

# ─────────────────────────────────────────────────────────────
# CÁCH 1 — ĐĂNG NHẬP BẰNG GOOGLE (khuyến nghị khi deploy)
# Mỗi Gmail là một tài khoản độc lập, project/profile tách riêng.
# Lấy 2 giá trị này trong Google Cloud Console → Credentials → OAuth client ID.
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (Tùy chọn) Chỉ cho phép một số email nhất định, cách nhau bằng dấu phẩy.
# Bỏ trống = bất kỳ ai có Gmail đều đăng nhập được.
# ALLOWED_EMAILS=ban@gmail.com,dongnghiep@gmail.com

# ─────────────────────────────────────────────────────────────
# CÁCH 2 — ĐĂNG NHẬP DÙNG CHUNG (cơ chế cũ)
# Chỉ dùng khi KHÔNG khai GOOGLE_CLIENT_ID ở trên.
# Mọi người dùng chung một kho dữ liệu.
# ─────────────────────────────────────────────────────────────
APP_USERNAME=HH_BKtools
APP_PASSWORD=Rio@BK2026

# Khóa ký session cookie (chuỗi ngẫu nhiên dài)
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai

# Tắt debug khi production (Railway sẽ không dùng khối __main__)
FLASK_DEBUG=0

# Đường dẫn dữ liệu bền vững trên Railway Volume (local để trống hoặc ".")
# DATA_DIR=/data
